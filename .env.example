HOST=127.0.0.1
# Temporary HTTP LAN access: HOST=0.0.0.0 and
# PUBLIC_ORIGIN=http://YOUR_PC_LAN_IP:3000 (no PWA offline mode).
PORT=3000
DATABASE_PATH=./data/planner.sqlite
# Set a new unique ID after deploying a breaking client change; empty disables it.
CLIENT_UPDATE_ID=
# Server only. Never prefix this variable with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ALLOWED_MODELS=gpt-6-luna,gpt-6-sol,gpt-5.6-luna,gpt-5.6-terra
# Set to the exact public URL when exposing the app through Caddy.
# PUBLIC_ORIGIN=https://repas.example.net

# Google sign-in and shared households (docs/authentification-google.md).
# false (default): historical mode, one common space synchronized without account.
# true requires PUBLIC_ORIGIN (https:, or http://localhost:<port> on this PC) and both Google values.
AUTH_ENABLED=false
# Server only, from Google Cloud console > Clients. Never commit them, never prefix with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_DAYS=30
# Optional graphical admin at /admin (requires AUTH_ENABLED=true).
# Full account UUIDs from "npm run admin -- users", comma-separated.
# Empty = no admin access. Never use e-mail addresses or VITE_ variables here.
ADMIN_USER_IDS=
# none (default) | cloudflare: use CF-Connecting-IP for rate limiting, only for requests
# coming from 127.0.0.1/::1 (local cloudflared). Requires HOST=127.0.0.1.
TRUSTED_PROXY=none
